# Browser-facing API URL. Baked into the client bundle at build time.
NEXT_PUBLIC_BACKEND_ENDPOINT=http://localhost:4000/api

# Optional: the address the Next.js *server* uses to reach the API, when it
# differs from the browser's. Needed under Docker Compose, where the browser
# sees localhost:4000 but the web container must use the service name.
# API_BASE_URL_INTERNAL=http://api:4000/api

# Leave both blank to use the API's self-hosted identity provider. Fill them in
# to authenticate against Supabase instead; the app detects which to use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
